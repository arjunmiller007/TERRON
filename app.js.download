"use strict";

document.addEventListener("DOMContentLoaded", async () => {

  window.addEventListener("terron:toast", event => {
    showToast(event.detail);
  });

  // ==========================================
  // TERRON PAGE INFORMATION
  // ==========================================

  const pageInfo = {
    overview: ["Earth Command Center", "A unified view of our planet and its interconnected systems."],
    earth: ["Earth Observation", "Explore the world through interactive geospatial monitoring."],
    weather: ["Weather Intelligence", "Weather conditions, forecasts and historical comparisons."],
    disasters: ["Disaster Intelligence", "Earthquakes and verified natural-event information."],
    environment: ["Environmental Intelligence", "Air quality, pollutants and environmental indicators."],
    forest: ["Forest & Nature", "Public nature and wildfire event information."],
    ocean: ["Ocean Intelligence", "Marine conditions and ocean forecast data."],
    agriculture: ["Agriculture Intelligence", "Weather and model-based soil information."],
    atmosphere: ["Atmosphere Intelligence", "Atmospheric conditions and related indicators."],
    analytics: ["Advanced Analytics", "Explore visualizations, comparisons and data-driven reports."],
    mission: ["Mission Control", "Monitor data connections, system health and data quality."],
  };

  // ==========================================
  // DOM ELEMENTS
  // ==========================================

  const navItems = document.querySelectorAll(".nav-item");
  const title = document.getElementById("pageTitle");
  const description = document.getElementById("pageDescription");
  const breadcrumb = document.getElementById("breadcrumbPage");
  const clock = document.getElementById("liveClock");
  const date = document.getElementById("dateDisplay");
  const toast = document.getElementById("toast");

  // ==========================================
  // APPLICATION STATE
  // ==========================================

  let currentPage = "overview";

  let currentLocation = {
    name: window.TERRON_CONFIG.defaultLocation.name,
    lat: window.TERRON_CONFIG.defaultLocation.lat,
    lng: window.TERRON_CONFIG.defaultLocation.lng
  };

  let data = {
    location: {},
    global: {}
  };

  let toastTimeout;
  let comparisonResults = [];
  let comparisonBusy = false;
  let correlationBusy = false;

  // ==========================================
  // NOTIFICATION SYSTEM
  // ==========================================

  function showToast(message) {
    if (!toast) {
      console.log(message);
      return;
    }

    toast.textContent = message;
    toast.classList.add("show");

    clearTimeout(toastTimeout);

    toastTimeout = setTimeout(() => {
      toast.classList.remove("show");
    }, 3000);
  }

  // ==========================================
  // HTML ESCAPING
  // ==========================================

  function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    })[char]);
  }

  // ==========================================
  // CLOCK
  // ==========================================

  function updateClock() {
    const now = new Date();

    if (clock) {
      clock.textContent = now.toLocaleTimeString("en-IN", {
        hour12: false,
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
      });
    }

    if (date) {
      date.textContent = now.toLocaleDateString("en-IN", {
        weekday: "short",
        day: "2-digit",
        month: "short",
        year: "numeric"
      });
    }
  }

  // ==========================================
  // DASHBOARD METRIC CARDS
  // ==========================================

  function updateMetricCards() {
    const cards = document.querySelectorAll(".metric-card .metric-value");

    const weather = data.location.weather?.data?.current;
    const air = data.location.air?.data?.current;
    const earthquakes = data.global.earthquakes?.data?.features;

    const readings = [
      weather?.temperature_2m != null
        ? `${weather.temperature_2m} °C`
        : "Unavailable",

      earthquakes
        ? `${earthquakes.length} EVENTS`
        : "Unavailable",

      air?.pm2_5 != null
        ? `${air.pm2_5} µg/m³`
        : "Unavailable",

      "GLOBAL MAP"
    ];

    cards.forEach((card, index) => {
      if (readings[index] !== undefined) {
        card.textContent = readings[index];
      }
    });

    const footers = document.querySelectorAll(".metric-card .metric-foot");

    const notes = [
      "Open-Meteo model current condition",
      "USGS past-day earthquake feed",
      "Open-Meteo CAMS model estimate",
      "Interactive Leaflet map"
    ];

    footers.forEach((item, index) => {
      if (notes[index]) item.textContent = notes[index];
    });
  }

  // ==========================================
  // MODULE STATUS
  // ==========================================

  function updateModuleList() {
    const statuses = [
      ["weather", data.location.weather],
      ["disasters", data.global.earthquakes],
      ["environment", data.location.air],
      ["forest", data.global.events],
      ["ocean", data.location.marine],
      ["agriculture", data.location.weather],
      ["atmosphere", data.location.weather],
      ["analytics", data.location.weather],
      ["mission", data.global.events],

    ];

    const rows = document.querySelectorAll(".module-row");

    rows.forEach((row, index) => {
      const status = statuses[index]?.[1];
      const label = row.querySelector(".module-state");

      if (!label) return;

      label.textContent = !status
        ? "READY"
        : status.ok
          ? "CONNECTED"
          : "UNAVAILABLE";

      label.style.color = !status
        ? "var(--cyan)"
        : status.ok
          ? "var(--green)"
          : "var(--orange)";
    });
  }

  // ==========================================
  // MODULE RENDERING
  // ==========================================

  function renderCurrentModule() {
    window.TERRON_MODULES.render(
      data,
      currentPage,
      currentLocation.name
    );

    if (currentPage === "analytics") {
      mountComparisonInterface();
    }

    if (currentPage === "mission") {
      window.TERRON_ALERTS?.mount(data);
    }
  }

  // ==========================================
  // PAGE NAVIGATION
  // ==========================================

  function showPage(page) {
    if (!pageInfo[page]) return;

    currentPage = page;

    navItems.forEach(item => {
      item.classList.toggle("active", item.dataset.page === page);
    });

    if (title) title.textContent = pageInfo[page][0];
    if (description) description.textContent = pageInfo[page][1];
    if (breadcrumb) breadcrumb.textContent = pageInfo[page][0].toUpperCase();

    const isOverview = page === "overview";

    const metricsGrid = document.querySelector(".metrics-grid");
    const dashboardGrid = document.querySelector(".dashboard-grid");
    const workspace = document.getElementById("dataWorkspace");

    if (metricsGrid) metricsGrid.hidden = !isOverview;
    if (dashboardGrid) dashboardGrid.hidden = !isOverview;

    if (workspace) {
      if (isOverview) {
        workspace.hidden = true;
      } else {
        renderCurrentModule();
      }
    }

    document.body.classList.remove("sidebar-open");
  }

  // ==========================================
  // LOCATION DATA REFRESH
  // ==========================================

  async function refreshLocation() {
    showToast("Retrieving location intelligence...");

    const result = await window.TERRON_API.loadLocation(
      currentLocation.lat,
      currentLocation.lng
    );

    data.location = result;

    updateMetricCards();
    updateModuleList();

    if (currentPage !== "overview") {
      renderCurrentModule();
    }

    showToast("Location data refresh completed.");
  }

  // ==========================================
  // GLOBAL EVENT REFRESH
  // ==========================================

  async function refreshGlobal() {
    showToast("Updating global event feeds...");

    data.global = await window.TERRON_API.loadGlobalEvents();

    window.TERRON_MAP.renderEvents(
      data.global.earthquakes?.data,
      data.global.events?.data
    );

    updateMetricCards();
    updateModuleList();

    if (currentPage !== "overview") {
      renderCurrentModule();
    }

    showToast("Global event refresh completed.");
  }

  // ==========================================
  // REFRESH EVERYTHING
  // ==========================================

  async function refreshAll() {
    await Promise.all([
      refreshLocation(),
      refreshGlobal()
    ]);
  }

  // ==========================================
  // LOCATION SEARCH
  // ==========================================

  async function searchLocation() {
    const input = document.getElementById("locationSearch");
    const button = document.getElementById("searchButton");

    const query = input?.value.trim();

    if (!query) {
      showToast("Enter a location first.");
      return;
    }

    button.disabled = true;
    button.textContent = "SEARCHING";

    try {
      const place = await window.TERRON_API.getLocation(query);

      currentLocation = {
        name: [place.name, place.admin1, place.country]
          .filter(Boolean)
          .join(", "),
        lat: Number(place.latitude),
        lng: Number(place.longitude)
      };

      window.TERRON_MAP.searchLocation(
        currentLocation.lat,
        currentLocation.lng,
        currentLocation.name
      );

      await refreshLocation();

    } catch (error) {
      console.error(error);
      showToast(`Location search failed: ${error.message}`);
    } finally {
      button.disabled = false;
      button.textContent = "SEARCH";
    }
  }

  // ==========================================
  // HISTORICAL WEATHER HELPERS
  // ==========================================

  function formatHistoricalValue(number, unit = "") {
    if (
      number === null ||
      number === undefined ||
      number === "" ||
      !Number.isFinite(Number(number))
    ) {
      return "Unavailable";
    }

    return `${Number(number).toFixed(1)} ${unit}`.trim();
  }

  function getArchiveMaximumDate() {
    const archiveDate = new Date();
    archiveDate.setDate(archiveDate.getDate() - 7);

    const year = archiveDate.getFullYear();
    const month = String(archiveDate.getMonth() + 1).padStart(2, "0");
    const day = String(archiveDate.getDate()).padStart(2, "0");

    return `${year}-${month}-${day}`;
  }

  // ==========================================
  // SVG HISTORICAL CHART HELPERS
  // ==========================================

  const chartColors = {
    average: "#20c9f3",
    maximum: "#ff9d54",
    minimum: "#43d7a0",
    rainfall: "#1689b5",
    wind: "#a78bfa"
  };

  function validNumber(value) {
    if (value === null || value === undefined || value === "") {
      return null;
    }

    const number = Number(value);
    return Number.isFinite(number) ? number : null;
  }

  function chartDateLabel(dateString) {
    const chartDate = new Date(`${dateString}T00:00:00`);

    if (Number.isNaN(chartDate.getTime())) {
      return String(dateString);
    }

    return chartDate.toLocaleDateString("en-IN", {
      day: "2-digit",
      month: "short"
    });
  }

  function chartLegend(series) {
    return `
      <div class="terron-chart-legend">
        ${series.map(item => `
          <span class="terron-legend-item">
            <span class="terron-legend-dot" style="background:${item.color}"></span>
            ${escapeHTML(item.name)}
          </span>
        `).join("")}
      </div>
    `;
  }

  function createLineChart(chartTitle, subtitle, dates, series, unit) {
    const validValues = series.flatMap(item =>
      item.values.map(validNumber).filter(value => value !== null)
    );

    if (!validValues.length) {
      return `
        <section class="terron-chart-card">
          <h3>${escapeHTML(chartTitle)}</h3>
          <p class="data-error">No valid readings available for this chart.</p>
        </section>
      `;
    }

    const width = 760;
    const height = 245;
    const left = 55;
    const right = 18;
    const top = 25;
    const bottom = 48;

    const plotWidth = width - left - right;
    const plotHeight = height - top - bottom;

    let min = Math.min(...validValues);
    let max = Math.max(...validValues);

    if (min === max) {
      min -= 1;
      max += 1;
    }

    const padding = (max - min) * 0.12;
    min -= padding;
    max += padding;

    const x = index => dates.length <= 1
      ? left + plotWidth / 2
      : left + (index / (dates.length - 1)) * plotWidth;

    const y = value =>
      top + ((max - value) / (max - min)) * plotHeight;

    const grid = Array.from({ length: 5 }, (_, i) => {
      const value = min + ((max - min) * i) / 4;
      const position = y(value);

      return `
        <line x1="${left}" y1="${position}"
          x2="${width - right}" y2="${position}"
          stroke="#536477" stroke-opacity=".3" stroke-dasharray="4 5"/>
        <text x="${left - 9}" y="${position + 4}"
          text-anchor="end" fill="#91a7bb" font-size="11">${value.toFixed(1)}</text>
      `;
    }).join("");

    const lines = series.map(item => {
      const segments = [];
      let currentSegment = [];

      item.values.forEach((rawValue, index) => {
        const number = validNumber(rawValue);

        if (number === null) {
          if (currentSegment.length) {
            segments.push(currentSegment);
            currentSegment = [];
          }
          return;
        }

        currentSegment.push({
          x: x(index),
          y: y(number),
          value: number,
          date: dates[index]
        });
      });

      if (currentSegment.length) segments.push(currentSegment);

      const paths = segments.map(segment => {
        if (segment.length < 2) return "";

        return `
          <polyline
            points="${segment.map(point => `${point.x},${point.y}`).join(" ")}"
            fill="none" stroke="${item.color}" stroke-width="2.8"
            stroke-linecap="round" stroke-linejoin="round"/>
        `;
      }).join("");

      const dots = segments.flatMap(segment =>
        segment.map(point => `
          <circle cx="${point.x}" cy="${point.y}" r="4"
            fill="${item.color}" stroke="#07111e" stroke-width="1.5">
            <title>${escapeHTML(point.date)} · ${escapeHTML(item.name)}: ${point.value.toFixed(1)} ${escapeHTML(unit)}</title>
          </circle>
        `)
      ).join("");

      return paths + dots;
    }).join("");

    const labelCount = Math.min(6, dates.length);

    const dateLabels = Array.from({ length: labelCount }, (_, i) => {
      const index = labelCount === 1
        ? 0
        : Math.round(i * (dates.length - 1) / (labelCount - 1));

      return `
        <text x="${x(index)}" y="${height - 15}"
          text-anchor="middle" fill="#91a7bb" font-size="10">
          ${escapeHTML(chartDateLabel(dates[index]))}
        </text>
      `;
    }).join("");

    return `
      <section class="terron-chart-card">
        <div class="terron-chart-heading">
          <div>
            <h3>${escapeHTML(chartTitle)}</h3>
            <p>${escapeHTML(subtitle)}</p>
          </div>
          <span class="terron-chart-unit">${escapeHTML(unit)}</span>
        </div>
        ${chartLegend(series)}
        <div class="terron-chart-scroll">
          <svg viewBox="0 0 ${width} ${height}" role="img"
            aria-label="${escapeHTML(chartTitle)}">
            ${grid}${lines}${dateLabels}
          </svg>
        </div>
      </section>
    `;
  }

  function createBarChart(chartTitle, subtitle, dates, values, unit, color) {
    const validValues = values.map(validNumber).filter(value => value !== null);

    if (!validValues.length) {
      return `
        <section class="terron-chart-card">
          <h3>${escapeHTML(chartTitle)}</h3>
          <p class="data-error">No valid readings available for this chart.</p>
        </section>
      `;
    }

    const width = 760;
    const height = 245;
    const left = 55;
    const right = 18;
    const top = 25;
    const bottom = 48;

    const plotWidth = width - left - right;
    const plotHeight = height - top - bottom;

    const maximum = Math.max(...validValues);
    const chartMaximum = maximum === 0 ? 1 : maximum * 1.15;

    const step = plotWidth / dates.length;
    const barWidth = Math.max(2, Math.min(24, step * 0.62));

    const grid = Array.from({ length: 5 }, (_, i) => {
      const value = chartMaximum * i / 4;
      const position = top + plotHeight - value / chartMaximum * plotHeight;

      return `
        <line x1="${left}" y1="${position}"
          x2="${width - right}" y2="${position}"
          stroke="#536477" stroke-opacity=".3" stroke-dasharray="4 5"/>
        <text x="${left - 9}" y="${position + 4}"
          text-anchor="end" fill="#91a7bb" font-size="11">${value.toFixed(1)}</text>
      `;
    }).join("");

    const bars = values.map((rawValue, index) => {
      const number = validNumber(rawValue);
      if (number === null) return "";

      const barHeight = number / chartMaximum * plotHeight;
      const barX = left + index * step + (step - barWidth) / 2;
      const barY = top + plotHeight - barHeight;

      return `
        <rect x="${barX}" y="${barY}" width="${barWidth}"
          height="${barHeight}" rx="3" fill="${color}" fill-opacity=".85">
          <title>${escapeHTML(dates[index])} · ${number.toFixed(1)} ${escapeHTML(unit)}</title>
        </rect>
      `;
    }).join("");

    const labelCount = Math.min(6, dates.length);

    const dateLabels = Array.from({ length: labelCount }, (_, i) => {
      const index = labelCount === 1
        ? 0
        : Math.round(i * (dates.length - 1) / (labelCount - 1));

      const position = left + index * step + step / 2;

      return `
        <text x="${position}" y="${height - 15}"
          text-anchor="middle" fill="#91a7bb" font-size="10">
          ${escapeHTML(chartDateLabel(dates[index]))}
        </text>
      `;
    }).join("");

    return `
      <section class="terron-chart-card">
        <div class="terron-chart-heading">
          <div>
            <h3>${escapeHTML(chartTitle)}</h3>
            <p>${escapeHTML(subtitle)}</p>
          </div>
          <span class="terron-chart-unit">${escapeHTML(unit)}</span>
        </div>
        <div class="terron-chart-scroll">
          <svg viewBox="0 0 ${width} ${height}" role="img"
            aria-label="${escapeHTML(chartTitle)}">
            ${grid}${bars}${dateLabels}
          </svg>
        </div>
      </section>
    `;
  }

  function addHistoricalChartStyles() {
    if (document.getElementById("terronChartStyles")) return;

    const style = document.createElement("style");
    style.id = "terronChartStyles";

    style.textContent = `
      .terron-historical-charts {
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:16px;
        margin:22px 0;
      }
      .terron-chart-card {
        min-width:0;
        padding:17px;
        border:1px solid rgba(0,195,255,.18);
        border-radius:12px;
        background:linear-gradient(145deg,rgba(10,27,43,.95),rgba(5,13,25,.98));
      }
      .terron-chart-heading {
        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        gap:10px;
        margin-bottom:12px;
      }
      .terron-chart-heading h3 {
        margin:0 0 6px;
        color:#e8f6ff;
        font-size:14px;
      }
      .terron-chart-heading p {
        margin:0;
        color:#8ca6bb;
        font-size:11px;
      }
      .terron-chart-unit {
        color:#20c9f3;
        font-size:11px;
        white-space:nowrap;
      }
      .terron-chart-legend {
        display:flex;
        flex-wrap:wrap;
        gap:13px;
        margin:10px 0;
      }
      .terron-legend-item {
        display:inline-flex;
        align-items:center;
        gap:6px;
        color:#b4c8d9;
        font-size:10px;
      }
      .terron-legend-dot {
        width:8px;
        height:8px;
        border-radius:50%;
      }
      .terron-chart-scroll {
        width:100%;
        overflow-x:auto;
      }
      .terron-chart-scroll svg {
        display:block;
        width:100%;
        min-width:320px;
        height:auto;
      }
      @media(max-width:850px) {
        .terron-historical-charts {grid-template-columns:1fr;}
      }
      @media(prefers-reduced-motion:no-preference) {
        .terron-chart-card {animation:terronChartAppear .45s ease both;}
        @keyframes terronChartAppear {
          from {opacity:0;transform:translateY(9px);}
          to {opacity:1;transform:translateY(0);}
        }
      }
    `;

    document.head.appendChild(style);
  }

  function buildHistoricalCharts(daily) {
    const dates = daily.time || [];

    return `
      <h3 class="data-heading">Historical Data Visualizations</h3>
      <p class="data-footnote">
        Chart values are taken from the historical API response for the selected coordinates and date range.
        Hover over points and bars to inspect readings.
      </p>
      <div class="terron-historical-charts">
        ${createLineChart(
          "Average Temperature Trend",
          "Daily mean temperature",
          dates,
          [{name:"Average temperature",values:daily.temperature_2m_mean || [],color:chartColors.average}],
          "°C"
        )}
        ${createLineChart(
          "Maximum & Minimum Temperature",
          "Daily temperature range",
          dates,
          [
            {name:"Maximum",values:daily.temperature_2m_max || [],color:chartColors.maximum},
            {name:"Minimum",values:daily.temperature_2m_min || [],color:chartColors.minimum}
          ],
          "°C"
        )}
        ${createBarChart(
          "Rainfall Analysis",
          "Daily precipitation total",
          dates,
          daily.precipitation_sum || [],
          "mm",
          chartColors.rainfall
        )}
        ${createLineChart(
          "Wind Speed Analysis",
          "Daily maximum wind speed",
          dates,
          [{name:"Maximum wind speed",values:daily.wind_speed_10m_max || [],color:chartColors.wind}],
          "km/h"
        )}
      </div>
    `;
  }

  // ==========================================
  // HISTORICAL WEATHER RESULTS
  // ==========================================

  function renderHistoricalResults(result) {
    const container = document.getElementById("historicalResults");
    if (!container) return;

    const daily = result?.daily;

    if (!daily?.time?.length) {
      container.innerHTML = `
        <p class="data-error">
          No historical records were returned for this date range.
          Try another date range.
        </p>
      `;
      return;
    }

    addHistoricalChartStyles();

    const temperatures = daily.temperature_2m_mean || [];
    const precipitation = daily.precipitation_sum || [];
    const windSpeeds = daily.wind_speed_10m_max || [];

    const validTemperatures = temperatures.map(validNumber).filter(v => v !== null);
    const validRainfall = precipitation.map(validNumber).filter(v => v !== null);
    const validWind = windSpeeds.map(validNumber).filter(v => v !== null);

    const averageTemperature = validTemperatures.length
      ? validTemperatures.reduce((a, b) => a + b, 0) / validTemperatures.length
      : null;

    const totalRainfall = validRainfall.length
      ? validRainfall.reduce((a, b) => a + b, 0)
      : null;

    const highestWind = validWind.length ? Math.max(...validWind) : null;

    const rows = daily.time.map((day, index) => `
      <tr>
        <td>${escapeHTML(day)}</td>
        <td>${formatHistoricalValue(temperatures[index], "°C")}</td>
        <td>${formatHistoricalValue(daily.temperature_2m_max?.[index], "°C")}</td>
        <td>${formatHistoricalValue(daily.temperature_2m_min?.[index], "°C")}</td>
        <td>${formatHistoricalValue(precipitation[index], "mm")}</td>
        <td>${formatHistoricalValue(windSpeeds[index], "km/h")}</td>
      </tr>
    `).join("");

    container.innerHTML = `
      <h3 class="data-heading">Historical Weather Summary</h3>
      <div class="metrics-grid">
        <article class="metric-card">
          <div class="metric-top">AVERAGE TEMPERATURE</div>
          <strong class="metric-value">${formatHistoricalValue(averageTemperature, "°C")}</strong>
          <div class="metric-foot">Selected historical period</div>
        </article>
        <article class="metric-card">
          <div class="metric-top">TOTAL PRECIPITATION</div>
          <strong class="metric-value">${formatHistoricalValue(totalRainfall, "mm")}</strong>
          <div class="metric-foot">Sum of daily precipitation</div>
        </article>
        <article class="metric-card">
          <div class="metric-top">MAXIMUM WIND SPEED</div>
          <strong class="metric-value">${formatHistoricalValue(highestWind, "km/h")}</strong>
          <div class="metric-foot">Highest daily maximum</div>
        </article>
      </div>

      ${buildHistoricalCharts(daily)}

      <h3 class="data-heading">Daily Historical Records</h3>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th><th>Mean Temp.</th><th>Max Temp.</th>
              <th>Min Temp.</th><th>Rainfall</th><th>Max Wind</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>

      <p class="data-success">Historical records retrieved successfully.</p>
      <p class="data-footnote">
        Source: Open-Meteo Historical Weather API. Values are reanalysis/model estimates,
        not direct weather-station observations.
      </p>
    `;
  }

  // ==========================================
  // LOAD HISTORICAL WEATHER
  // ==========================================

  async function loadHistoricalWeather() {
    const startInput = document.getElementById("historyStart");
    const endInput = document.getElementById("historyEnd");
    const button = document.getElementById("loadHistoricalBtn");
    const results = document.getElementById("historicalResults");

    if (!startInput || !endInput || !button || !results) {
      showToast("Historical explorer interface not found.");
      return;
    }

    const startDate = startInput.value;
    const endDate = endInput.value;
    const maximumDate = getArchiveMaximumDate();

    if (!startDate || !endDate) {
      showToast("Select both historical dates.");
      return;
    }

    if (startDate > endDate) {
      showToast("Start date must be before end date.");
      return;
    }

    if (endDate > maximumDate) {
      showToast("Choose an end date at least seven days in the past.");
      return;
    }

    button.disabled = true;
    button.textContent = "LOADING...";

    results.innerHTML = `
      <p class="data-success">
        Retrieving historical weather records for ${escapeHTML(currentLocation.name)}...
      </p>
    `;

    try {
      const historicalData = await window.TERRON_API.getHistoricalWeather(
        currentLocation.lat,
        currentLocation.lng,
        startDate,
        endDate
      );

      renderHistoricalResults(historicalData);
      showToast("Historical weather charts and data loaded.");
    } catch (error) {
      console.error("TERRON historical weather error:", error);

      results.innerHTML = `
        <p class="data-error">
          Historical data retrieval failed: ${escapeHTML(error.message)}
        </p>
        <p class="data-footnote">Check your connection or try another date range.</p>
      `;

      showToast("Historical data retrieval failed.");
    } finally {
      button.disabled = false;
      button.textContent = "LOAD HISTORICAL DATA";
    }
  }

  // ==========================================
  // GLOBAL LOCATION COMPARISON
  // ==========================================

  function mountComparisonInterface() {
    const panel = document.querySelector("#dataWorkspace .data-module-panel");

    if (!panel || document.getElementById("locationComparisonPanel")) return;

    const history = document.getElementById("historicalResults");

    const comparisonHTML = `
      <section id="locationComparisonPanel" class="terron-comparison-panel">
        <h3 class="data-heading">Global Location Comparison</h3>

        <p class="data-footnote">
          Compare current weather and air-quality model data from up to four locations.
          Enter city or town names. Each location is retrieved independently.
        </p>

        <div class="terron-comparison-inputs">
          <label>
            LOCATION 1
            <input id="compareLocation1" type="text"
              value="${escapeHTML(currentLocation.name)}"
              placeholder="Example: Madurai">
          </label>
          <label>
            LOCATION 2
            <input id="compareLocation2" type="text"
              placeholder="Example: Chennai">
          </label>
          <label>
            LOCATION 3
            <input id="compareLocation3" type="text"
              placeholder="Example: Tokyo">
          </label>
          <label>
            LOCATION 4
            <input id="compareLocation4" type="text"
              placeholder="Example: London">
          </label>
        </div>

        <div class="terron-comparison-actions">
          <button type="button" id="runComparisonBtn">COMPARE LOCATIONS</button>
          <button type="button" id="exportComparisonBtn" disabled>EXPORT COMPARISON CSV</button>
        </div>

        <div id="comparisonResults" aria-live="polite">
          <p class="data-footnote">
            Add at least two locations and select Compare Locations.
          </p>
        </div>
      </section>
    `;

    if (history) {
      history.insertAdjacentHTML("afterend", comparisonHTML);
    } else {
      panel.insertAdjacentHTML("beforeend", comparisonHTML);
    }

    addComparisonStyles();
  }

  function addComparisonStyles() {
    if (document.getElementById("terronComparisonStyles")) return;

    const style = document.createElement("style");
    style.id = "terronComparisonStyles";

    style.textContent = `
      .terron-comparison-panel {
        margin:28px 0;
        padding:20px;
        border:1px solid rgba(0,195,255,.2);
        border-radius:13px;
        background:linear-gradient(145deg,rgba(8,24,40,.94),rgba(4,12,23,.98));
      }
      .terron-comparison-inputs {
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:14px;
        margin:18px 0;
      }
      .terron-comparison-inputs label {
        display:flex;
        flex-direction:column;
        gap:7px;
        color:#8ca6bb;
        font-size:10px;
        letter-spacing:1px;
      }
      .terron-comparison-inputs input {
        width:100%;
        min-width:0;
        padding:12px;
        color:#eaf8ff;
        background:#071522;
        border:1px solid rgba(0,195,255,.25);
        border-radius:8px;
        font:inherit;
        outline:none;
      }
      .terron-comparison-inputs input:focus {
        border-color:#20c9f3;
        box-shadow:0 0 0 2px rgba(32,201,243,.12);
      }
      .terron-comparison-actions {
        display:flex;
        flex-wrap:wrap;
        gap:10px;
        margin:14px 0 20px;
      }
      .terron-comparison-actions button {
        padding:12px 17px;
        color:#fff;
        background:linear-gradient(135deg,#063b55,#087b9e);
        border:1px solid #16c9f5;
        border-radius:8px;
        font:inherit;
        font-size:11px;
        font-weight:700;
        letter-spacing:.6px;
        cursor:pointer;
      }
      .terron-comparison-actions button:disabled {
        opacity:.45;
        cursor:not-allowed;
      }
      .terron-comparison-table-wrap {
        width:100%;
        overflow-x:auto;
        margin:18px 0;
      }
      .terron-comparison-table {
        width:100%;
        min-width:650px;
        border-collapse:collapse;
        font-size:12px;
      }
      .terron-comparison-table th,
      .terron-comparison-table td {
        padding:12px;
        text-align:left;
        border-bottom:1px solid rgba(120,160,190,.15);
      }
      .terron-comparison-table th {
        color:#20c9f3;
        background:rgba(0,195,255,.06);
      }
      .terron-comparison-table td {
        color:#d5e7f4;
      }
      .terron-comparison-chart {
        display:grid;
        gap:14px;
        margin:20px 0;
      }
      .terron-comparison-chart h4 {
        margin:0 0 10px;
        color:#e8f6ff;
        font-size:13px;
      }
      .terron-compare-bar-row {
        display:grid;
        grid-template-columns:minmax(85px,140px) 1fr 65px;
        align-items:center;
        gap:10px;
        margin:8px 0;
        font-size:11px;
      }
      .terron-compare-bar-track {
        height:10px;
        overflow:hidden;
        border-radius:20px;
        background:#102333;
      }
      .terron-compare-bar {
        height:100%;
        min-width:0;
        border-radius:20px;
        background:linear-gradient(90deg,#087b9e,#20c9f3);
      }
      .terron-compare-number {
        color:#dff8ff;
        text-align:right;
      }
      @media(max-width:650px) {
        .terron-comparison-inputs {grid-template-columns:1fr;}
        .terron-comparison-panel {padding:13px;}
      }
    `;

    document.head.appendChild(style);
  }

  function getComparisonReading(value, unit = "") {
    if (value === null || value === undefined || value === "") {
      return "Unavailable";
    }

    const number = Number(value);

    return Number.isFinite(number)
      ? `${number.toFixed(1)} ${unit}`.trim()
      : "Unavailable";
  }

  async function retrieveComparisonLocation(query) {
    const place = await window.TERRON_API.getLocation(query);

    const location = {
      name: [place.name, place.admin1, place.country]
        .filter(Boolean)
        .join(", "),
      lat: Number(place.latitude),
      lng: Number(place.longitude)
    };

    if (!Number.isFinite(location.lat) || !Number.isFinite(location.lng)) {
      throw new Error("The location returned invalid coordinates.");
    }

    const [weatherResult, airResult] = await Promise.allSettled([
      window.TERRON_API.getWeather(location.lat, location.lng),
      window.TERRON_API.getAirQuality(location.lat, location.lng)
    ]);

    return {
      ...location,
      weather: weatherResult.status === "fulfilled"
        ? weatherResult.value
        : null,
      air: airResult.status === "fulfilled"
        ? airResult.value
        : null,
      weatherError: weatherResult.status === "rejected"
        ? weatherResult.reason.message
        : null,
      airError: airResult.status === "rejected"
        ? airResult.reason.message
        : null
    };
  }

  function comparisonBar(chartTitle, key, unit, color) {
    const available = comparisonResults
      .map(item => ({
        name: item.name,
        value: validNumber(item[key])
      }))
      .filter(item => item.value !== null);

    if (!available.length) {
      return `
        <div>
          <h4>${escapeHTML(chartTitle)}</h4>
          <p class="data-error">No comparable readings are available.</p>
        </div>
      `;
    }

    const maxValue = Math.max(...available.map(item => item.value));
    const scale = maxValue > 0 ? maxValue : 1;

    return `
      <div>
        <h4>${escapeHTML(chartTitle)}</h4>
        ${available.map(item => {
          const width = Math.max(0, Math.min(100, item.value / scale * 100));

          return `
            <div class="terron-compare-bar-row">
              <span>${escapeHTML(item.name)}</span>
              <div class="terron-compare-bar-track">
                <div class="terron-compare-bar"
                  style="width:${width}%;background:${color}"></div>
              </div>
              <span class="terron-compare-number">
                ${item.value.toFixed(1)} ${escapeHTML(unit)}
              </span>
            </div>
          `;
        }).join("")}
      </div>
    `;
  }

  function renderComparisonResults(results) {
    const container = document.getElementById("comparisonResults");
    const exportButton = document.getElementById("exportComparisonBtn");

    if (!container) return;

    comparisonResults = results;

    const successful = results.filter(item => item.weather || item.air);

    if (exportButton) {
      exportButton.disabled = successful.length === 0;
    }

    const rows = results.map(item => {
      const weather = item.weather?.current;
      const air = item.air?.current;

      return `
        <tr>
          <td>${escapeHTML(item.name)}</td>
          <td>${getComparisonReading(weather?.temperature_2m, "°C")}</td>
          <td>${getComparisonReading(weather?.apparent_temperature, "°C")}</td>
          <td>${getComparisonReading(weather?.relative_humidity_2m, "%")}</td>
          <td>${getComparisonReading(weather?.wind_speed_10m, "km/h")}</td>
          <td>${getComparisonReading(air?.us_aqi, "AQI")}</td>
          <td>${getComparisonReading(air?.pm2_5, "µg/m³")}</td>
          <td>${item.weather || item.air ? "PARTIAL / CONNECTED" : "UNAVAILABLE"}</td>
        </tr>
      `;
    }).join("");

    container.innerHTML = `
      <h3 class="data-heading">Location Comparison Results</h3>

      <div class="terron-comparison-table-wrap">
        <table class="terron-comparison-table">
          <thead>
            <tr>
              <th>Location</th>
              <th>Temperature</th>
              <th>Feels Like</th>
              <th>Humidity</th>
              <th>Wind</th>
              <th>US AQI</th>
              <th>PM2.5</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>

      <div class="terron-comparison-chart">
        ${comparisonBar("Temperature comparison", "temperature", "°C", "#20c9f3")}
        ${comparisonBar("Humidity comparison", "humidity", "%", "#43d7a0")}
        ${comparisonBar("Wind speed comparison", "wind", "km/h", "#a78bfa")}
        ${comparisonBar("PM2.5 comparison", "pm25", "µg/m³", "#ff9d54")}
      </div>

      <p class="data-footnote">
        Sources: Open-Meteo Weather and Air Quality APIs.
        Weather and air-quality values are model-based estimates, not direct
        measurements from local monitoring stations. Comparisons use each
        location's returned current-data fields and retrieval time.
      </p>
    `;
  }

  async function runLocationComparison() {
    if (comparisonBusy) return;

    const button = document.getElementById("runComparisonBtn");
    const container = document.getElementById("comparisonResults");

    if (!button || !container) return;

    const queries = [1, 2, 3, 4]
      .map(index => document.getElementById(`compareLocation${index}`)?.value.trim() || "")
      .filter(Boolean);

    if (queries.length < 2) {
      showToast("Enter at least two locations to compare.");
      return;
    }

    if (new Set(queries.map(query => query.toLowerCase())).size !== queries.length) {
      showToast("Remove duplicate location entries.");
      return;
    }

    comparisonBusy = true;
    button.disabled = true;
    button.textContent = "COMPARING...";

    container.innerHTML = `
      <p class="data-success">
        Retrieving weather and air-quality data for ${queries.length} locations...
      </p>
    `;

    try {
      const results = await Promise.all(
        queries.map(async query => {
          try {
            return await retrieveComparisonLocation(query);
          } catch (error) {
            return {
              name: query,
              lat: null,
              lng: null,
              weather: null,
              air: null,
              weatherError: error.message,
              airError: error.message
            };
          }
        })
      );

      const normalized = results.map(item => ({
        ...item,
        temperature: validNumber(item.weather?.current?.temperature_2m),
        humidity: validNumber(item.weather?.current?.relative_humidity_2m),
        wind: validNumber(item.weather?.current?.wind_speed_10m),
        pm25: validNumber(item.air?.current?.pm2_5)
      }));

      renderComparisonResults(normalized);

      const count = normalized.filter(item => item.weather || item.air).length;

      showToast(`${count} of ${normalized.length} locations returned data.`);

    } catch (error) {
      console.error("TERRON comparison error:", error);

      container.innerHTML = `
        <p class="data-error">
          Comparison failed: ${escapeHTML(error.message)}
        </p>
      `;

      showToast("Location comparison failed.");
    } finally {
      comparisonBusy = false;
      button.disabled = false;
      button.textContent = "COMPARE LOCATIONS";
    }
  }

  function exportComparisonCSV() {
    if (!comparisonResults.length) {
      showToast("Run a location comparison first.");
      return;
    }

    const headers = [
      "Location",
      "Latitude",
      "Longitude",
      "Temperature C",
      "Feels Like C",
      "Humidity Percent",
      "Wind Speed kmh",
      "US AQI",
      "PM2.5 ugm3",
      "Weather Status",
      "Air Quality Status"
    ];

    const rows = comparisonResults.map(item => {
      const weather = item.weather?.current;
      const air = item.air?.current;

      return [
        item.name,
        item.lat,
        item.lng,
        weather?.temperature_2m,
        weather?.apparent_temperature,
        weather?.relative_humidity_2m,
        weather?.wind_speed_10m,
        air?.us_aqi,
        air?.pm2_5,
        item.weather ? "Connected" : item.weatherError || "Unavailable",
        item.air ? "Connected" : item.airError || "Unavailable"
      ];
    });

    const csvEscape = value => {
      const text = String(value ?? "");
      return `"${text.replace(/"/g, '""')}"`;
    };

    const csv = [
      headers.map(csvEscape).join(","),
      ...rows.map(row => row.map(csvEscape).join(","))
    ].join("\r\n");

    const blob = new Blob([csv], {
      type: "text/csv;charset=utf-8;"
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = `TERRON_Location_Comparison_${Date.now()}.csv`;

    document.body.appendChild(link);
    link.click();
    link.remove();

    setTimeout(() => URL.revokeObjectURL(url), 1000);

    showToast("Comparison CSV exported.");
  }

  // ==========================================
  // ENVIRONMENTAL CORRELATION ENGINE
  // ==========================================

  async function runCorrelationAnalysis() {
    if (correlationBusy) return;

    const runButton = document.getElementById("runCorrelationBtn");
    const refreshButton = document.getElementById("refreshCorrelationBtn");
    const status = document.getElementById("correlationStatus");
    const results = document.getElementById("correlationResults");

    if (!runButton || !results) {
      showToast("Correlation interface not found.");
      return;
    }

    if (!window.TERRON_CORRELATION ||
        typeof window.TERRON_CORRELATION.analyze !== "function" ||
        typeof window.TERRON_CORRELATION.render !== "function") {
      showToast("Correlation engine is not loaded. Check correlation.js.");
      if (status) {
        status.textContent = "Correlation engine unavailable. Check the script loading order.";
      }
      return;
    }

    if (!window.TERRON_API ||
        typeof window.TERRON_API.getCorrelationData !== "function") {
      showToast("Correlation data service is unavailable. Check api.js.");
      if (status) {
        status.textContent = "Correlation API function unavailable. Check getCorrelationData() in api.js.";
      }
      return;
    }

    const lat = Number(currentLocation.lat);
    const lng = Number(currentLocation.lng);

    if (
      !Number.isFinite(lat) ||
      !Number.isFinite(lng) ||
      lat < -90 ||
      lat > 90 ||
      lng < -180 ||
      lng > 180
    ) {
      showToast("The selected location has invalid coordinates.");
      return;
    }

    correlationBusy = true;

    runButton.disabled = true;
    runButton.textContent = "ANALYSING...";

    if (refreshButton) {
      refreshButton.disabled = true;
    }

    if (status) {
      status.textContent = `Retrieving environmental data for ${currentLocation.name}...`;
    }

    results.innerHTML = `
      <p class="data-success">
        Analysing hourly weather and air-quality data. Please wait...
      </p>
    `;

    try {
      const analysis = await window.TERRON_CORRELATION.analyze(lat, lng);

      const rendered = window.TERRON_CORRELATION.render(analysis);

      if (typeof rendered === "string") {
        results.innerHTML = rendered;
      } else {
        throw new Error("The correlation engine did not return a valid results display.");
      }

      if (status) {
        status.textContent =
          `Analysis completed for ${currentLocation.name}. ` +
          "Review the four environmental relationships below.";
      }

      showToast("Environmental correlation analysis completed.");

    } catch (error) {
      console.error("TERRON correlation analysis error:", error);

      results.innerHTML = `
        <div class="terron-correlation-unavailable">
          <h3>Analysis could not be completed</h3>
          <p>${escapeHTML(error.message || "An unexpected error occurred.")}</p>
          <p>Check your internet connection and the browser console, then try again.</p>
        </div>
      `;

      if (status) {
        status.textContent = "Analysis failed. Check the error message and try again.";
      }

      showToast("Environmental correlation analysis failed.");

    } finally {
      correlationBusy = false;

      runButton.disabled = false;
      runButton.textContent = "RUN CORRELATION ANALYSIS";

      if (refreshButton) {
        refreshButton.disabled = false;
      }
    }
  }

  // ==========================================
  // REPORT AND CSV EXPORT
  // ==========================================

  function handleReportExport() {
    if (!window.TERRON_REPORTS) {
      showToast("Report module is not loaded.");
      return;
    }

    try {
      window.TERRON_REPORTS.exportReport(data, currentLocation);
      showToast("Intelligence report requested.");
    } catch (error) {
      console.error("Report export error:", error);
      showToast("Unable to generate the report.");
    }
  }

  function handleCSVExport() {
    if (!window.TERRON_REPORTS) {
      showToast("Report module is not loaded.");
      return;
    }

    try {
      window.TERRON_REPORTS.exportCSV(data, currentLocation);
      showToast("CSV export requested.");
    } catch (error) {
      console.error("CSV export error:", error);
      showToast("Unable to export CSV data.");
    }
  }

  // ==========================================
  // EVENT DELEGATION
  // ==========================================

  document.addEventListener("click", event => {
    const target = event.target;

    if (!target?.closest) return;

    if (target.closest("#generateReportBtn")) {
      handleReportExport();
      return;
    }

    if (target.closest("#exportCSVBtn")) {
      handleCSVExport();
      return;
    }

    if (target.closest("#loadHistoricalBtn")) {
      loadHistoricalWeather();
      return;
    }

    if (target.closest("#runComparisonBtn")) {
      runLocationComparison();
      return;
    }

    if (target.closest("#exportComparisonBtn")) {
      exportComparisonCSV();
      return;
    }

    if (
      target.closest("#runCorrelationBtn") ||
      target.closest("#refreshCorrelationBtn")
    ) {
      runCorrelationAnalysis();
    }
  });

  // ==========================================
  // NAVIGATION EVENTS
  // ==========================================

  navItems.forEach(item => {
    item.addEventListener("click", () => {
      showPage(item.dataset.page);
    });
  });

  // ==========================================
  // MOBILE MENU
  // ==========================================

  document.getElementById("menuToggle")
    ?.addEventListener("click", () => {
      document.body.classList.toggle("sidebar-open");
    });

  // ==========================================
  // MAP RESET
  // ==========================================

  document.getElementById("resetMap")
    ?.addEventListener("click", () => {
      window.TERRON_MAP.reset();
      showToast("Map view reset.");
    });

  // ==========================================
  // LOCATION SEARCH EVENTS
  // ==========================================

  document.getElementById("searchButton")
    ?.addEventListener("click", searchLocation);

  document.getElementById("locationSearch")
    ?.addEventListener("keydown", event => {
      if (event.key === "Enter") searchLocation();
    });

  // ==========================================
  // LAYOUT SWITCHER
  // ==========================================

  document.getElementById("layoutButton")
    ?.addEventListener("click", () => {
      const layouts = window.TERRON_CONFIG.layouts;

      const current = layouts.findIndex(
        layout => layout.id === document.body.dataset.layout
      );

      const selected = layouts[(current + 1) % layouts.length];

      document.body.dataset.layout = selected.id;

      setTimeout(() => {
        window.TERRON_MAP.getMap()?.invalidateSize();
      }, 300);

      showToast(`Layout: ${selected.name}`);
    });

  // ==========================================
  // MAP LOCATION CHANGE
  // ==========================================

  document.addEventListener("terron:locationchange", async event => {
    currentLocation = event.detail;

    try {
      await refreshLocation();
    } catch (error) {
      console.error("Location refresh error:", error);
      showToast("Unable to refresh selected location.");
    }
  });

  // ==========================================
  // TERRON INITIALIZATION
  // ==========================================

  try {
    window.TERRON_MAP.initialize();
    window.TERRON_MODULES.mount();

    updateClock();
    setInterval(updateClock, 1000);

    await refreshAll();

    console.info("TERRON: Initial data retrieval finished.");

  } catch (error) {
    console.error("TERRON initialization error:", error);
    showToast("Initialization error. Check browser console.");
  }

  // ==========================================
  // AUTOMATIC REFRESH
  // ==========================================

  setInterval(async () => {
    try {
      await refreshAll();
    } catch (error) {
      console.error("Automatic refresh error:", error);
      showToast("Some data sources could not refresh.");
    }
  }, window.TERRON_CONFIG.refreshInterval);

  // ==========================================
  // GLOBAL MANUAL REFRESH
  // ==========================================

  window.TERRON_REFRESH = refreshAll;
  window.TERRON_LOAD_HISTORY = loadHistoricalWeather;
  window.TERRON_COMPARE_LOCATIONS = runLocationComparison;
  window.TERRON_RUN_CORRELATION = runCorrelationAnalysis;

});