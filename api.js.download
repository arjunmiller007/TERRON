"use strict";

window.TERRON_API = (() => {

  // ==========================================
  // API ENDPOINTS
  // ==========================================

  const BASE = {
    weather: "https://api.open-meteo.com/v1/forecast",
    air: "https://air-quality-api.open-meteo.com/v1/air-quality",
    marine: "https://marine-api.open-meteo.com/v1/marine",
    earthquakes: "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson",
    events: "https://eonet.gsfc.nasa.gov/api/v3/events",
    historical: "https://archive-api.open-meteo.com/v1/archive"
  };

  // ==========================================
  // REQUEST HANDLER
  // ==========================================

  async function request(url, source) {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 18000);

    try {
      const response = await fetch(url, {
        signal: controller.signal,
        headers: { Accept: "application/json" }
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      return await response.json();

    } catch (error) {
      console.error(`${source} API error:`, error);

      throw new Error(
        error.name === "AbortError"
          ? "Request timed out"
          : error.message || "Network request failed"
      );

    } finally {
      clearTimeout(timeout);
    }
  }

  // ==========================================
  // URL BUILDER
  // ==========================================

  function makeURL(base, params) {
    const url = new URL(base);

    Object.entries(params).forEach(([key, value]) => {
      url.searchParams.set(key, value);
    });

    return url.toString();
  }

  // ==========================================
  // COORDINATE VALIDATION
  // ==========================================

  function validateCoordinates(lat, lng) {
    return (
      Number.isFinite(Number(lat)) &&
      Number.isFinite(Number(lng)) &&
      Number(lat) >= -90 &&
      Number(lat) <= 90 &&
      Number(lng) >= -180 &&
      Number(lng) <= 180
    );
  }

  // ==========================================
  // WEATHER INTELLIGENCE
  // ==========================================

  async function getWeather(lat, lng) {
    const url = makeURL(BASE.weather, {
      latitude: lat,
      longitude: lng,

      current: [
        "temperature_2m",
        "relative_humidity_2m",
        "apparent_temperature",
        "precipitation",
        "weather_code",
        "wind_speed_10m",
        "wind_direction_10m",
        "surface_pressure",
        "cloud_cover"
      ].join(","),

      hourly: [
        "temperature_2m",
        "relative_humidity_2m",
        "precipitation",
        "precipitation_probability",
        "visibility",
        "uv_index",
        "wind_speed_10m",
        "soil_temperature_0cm",
        "soil_moisture_0_to_1cm"
      ].join(","),

      daily: [
        "temperature_2m_max",
        "temperature_2m_min",
        "precipitation_sum",
        "sunrise",
        "sunset"
      ].join(","),

      forecast_days: 5,
      timezone: "auto"
    });

    return request(url, "Weather");
  }

  // ==========================================
  // HISTORICAL WEATHER
  // ==========================================

  async function getHistoricalWeather(
    lat,
    lng,
    startDate,
    endDate
  ) {
    if (
      !validateCoordinates(lat, lng) ||
      !startDate ||
      !endDate ||
      startDate > endDate
    ) {
      throw new Error("Invalid historical date range or coordinates");
    }

    const url = makeURL(BASE.historical, {
      latitude: lat,
      longitude: lng,
      start_date: startDate,
      end_date: endDate,

      daily: [
        "temperature_2m_mean",
        "temperature_2m_max",
        "temperature_2m_min",
        "precipitation_sum",
        "wind_speed_10m_max"
      ].join(","),

      timezone: "auto"
    });

    return request(url, "Historical weather");
  }

  // ==========================================
  // AIR QUALITY INTELLIGENCE
  // ==========================================

  async function getAirQuality(lat, lng) {
    const url = makeURL(BASE.air, {
      latitude: lat,
      longitude: lng,

      current: [
        "european_aqi",
        "us_aqi",
        "pm10",
        "pm2_5",
        "carbon_monoxide",
        "nitrogen_dioxide",
        "sulphur_dioxide",
        "ozone",
        "dust"
      ].join(","),

      forecast_days: 3,
      timezone: "auto"
    });

    return request(url, "Air quality");
  }

  // ==========================================
  // MARINE INTELLIGENCE
  // ==========================================

  async function getMarine(lat, lng) {
    const url = makeURL(BASE.marine, {
      latitude: lat,
      longitude: lng,

      current: [
        "wave_height",
        "wave_direction",
        "wave_period",
        "sea_surface_temperature"
      ].join(","),

      hourly: [
        "wave_height",
        "wave_direction",
        "wave_period",
        "sea_surface_temperature"
      ].join(","),

      forecast_days: 3,
      timezone: "auto",
      cell_selection: "sea"
    });

    return request(url, "Marine");
  }

  // ==========================================
  // EARTHQUAKE DATA
  // ==========================================

  async function getEarthquakes() {
    return request(BASE.earthquakes, "USGS earthquakes");
  }

  // ==========================================
  // NATURAL EVENTS
  // ==========================================

  async function getNaturalEvents() {
    const url = makeURL(BASE.events, {
      status: "open",
      limit: 100,
      days: 30
    });

    return request(url, "NASA EONET");
  }

  // ==========================================
  // LOCATION SEARCH
  // ==========================================

  async function getLocation(name) {
    const url = makeURL(
      "https://geocoding-api.open-meteo.com/v1/search",
      {
        name,
        count: 1,
        language: "en",
        format: "json"
      }
    );

    const result = await request(url, "Location search");

    if (!result.results || !result.results.length) {
      throw new Error("Location not found");
    }

    return result.results[0];
  }

  // ==========================================
  // LOCATION DATA LOADER
  // ==========================================

  async function loadLocation(lat, lng) {
    if (!validateCoordinates(lat, lng)) {
      throw new Error("Invalid location coordinates");
    }

    const tasks = {
      weather: getWeather(lat, lng),
      air: getAirQuality(lat, lng),
      marine: getMarine(lat, lng)
    };

    const results = await Promise.allSettled(
      Object.values(tasks)
    );

    const output = {};

    Object.keys(tasks).forEach((key, index) => {
      const result = results[index];

      output[key] = result.status === "fulfilled"
        ? {
            ok: true,
            data: result.value,
            error: null,
            updatedAt: new Date().toISOString()
          }
        : {
            ok: false,
            data: null,
            error: result.reason.message,
            updatedAt: null
          };
    });

    return output;
  }

  // ==========================================
  // GLOBAL LOCATION COMPARISON
  // ==========================================

  async function loadComparisonLocation(location) {
    if (
      !location ||
      !validateCoordinates(location.lat, location.lng)
    ) {
      throw new Error("Invalid comparison location");
    }

    const lat = Number(location.lat);
    const lng = Number(location.lng);

    const tasks = {
      weather: getWeather(lat, lng),
      air: getAirQuality(lat, lng),
      marine: getMarine(lat, lng)
    };

    const results = await Promise.allSettled(
      Object.values(tasks)
    );

    const output = {
      name: String(location.name || "Unnamed location"),
      lat,
      lng,
      sources: {}
    };

    Object.keys(tasks).forEach((key, index) => {
      const result = results[index];

      output.sources[key] =
        result.status === "fulfilled"
          ? {
              ok: true,
              data: result.value,
              error: null,
              updatedAt: new Date().toISOString()
            }
          : {
              ok: false,
              data: null,
              error: result.reason.message,
              updatedAt: null
            };
    });

    return output;
  }

  async function compareLocations(locations) {
    if (!Array.isArray(locations)) {
      throw new Error("Locations must be provided as an array");
    }

    if (locations.length < 2) {
      throw new Error("Select at least two locations");
    }

    if (locations.length > 4) {
      throw new Error("A maximum of four locations can be compared");
    }

    const results = await Promise.allSettled(
      locations.map(loadComparisonLocation)
    );

    return {
      generatedAt: new Date().toISOString(),
      totalLocations: locations.length,

      locations: results.map((result, index) => {
        if (result.status === "fulfilled") {
          return result.value;
        }

        return {
          name: locations[index]?.name || "Unknown location",
          lat: locations[index]?.lat ?? null,
          lng: locations[index]?.lng ?? null,
          sources: {},
          error: result.reason.message
        };
      })
    };
  }

  // ==========================================
  // PHASE 4D — CORRELATION DATA
  // ==========================================

  async function getCorrelationData(lat, lng) {
    if (!validateCoordinates(lat, lng)) {
      throw new Error(
        "Invalid coordinates for correlation analysis"
      );
    }

    const weatherURL = makeURL(BASE.weather, {
      latitude: lat,
      longitude: lng,

      hourly: [
        "temperature_2m",
        "relative_humidity_2m",
        "precipitation",
        "wind_speed_10m",
        "soil_moisture_0_to_1cm"
      ].join(","),

      forecast_days: 3,
      timezone: "auto"
    });

    const airURL = makeURL(BASE.air, {
      latitude: lat,
      longitude: lng,

      hourly: [
        "us_aqi",
        "pm2_5"
      ].join(","),

      forecast_days: 3,
      timezone: "auto"
    });

    const results = await Promise.allSettled([
      request(weatherURL, "Correlation weather"),
      request(airURL, "Correlation air quality")
    ]);

    return {
      generatedAt: new Date().toISOString(),

      weather: results[0].status === "fulfilled"
        ? {
            ok: true,
            data: results[0].value,
            error: null,
            updatedAt: new Date().toISOString()
          }
        : {
            ok: false,
            data: null,
            error: results[0].reason.message,
            updatedAt: null
          },

      air: results[1].status === "fulfilled"
        ? {
            ok: true,
            data: results[1].value,
            error: null,
            updatedAt: new Date().toISOString()
          }
        : {
            ok: false,
            data: null,
            error: results[1].reason.message,
            updatedAt: null
          }
    };
  }

  // ==========================================
  // GLOBAL EVENT LOADER
  // ==========================================

  async function loadGlobalEvents() {
    const tasks = [
      getEarthquakes(),
      getNaturalEvents()
    ];

    const results = await Promise.allSettled(tasks);

    return {
      earthquakes: results[0].status === "fulfilled"
        ? {
            ok: true,
            data: results[0].value,
            error: null,
            updatedAt: new Date().toISOString()
          }
        : {
            ok: false,
            data: null,
            error: results[0].reason.message,
            updatedAt: null
          },

      events: results[1].status === "fulfilled"
        ? {
            ok: true,
            data: results[1].value,
            error: null,
            updatedAt: new Date().toISOString()
          }
        : {
            ok: false,
            data: null,
            error: results[1].reason.message,
            updatedAt: null
          }
    };
  }

  // ==========================================
  // PUBLIC API
  // ==========================================

  return {
    getWeather,
    getHistoricalWeather,
    getAirQuality,
    getMarine,
    getEarthquakes,
    getNaturalEvents,
    getLocation,
    loadLocation,
    loadComparisonLocation,
    compareLocations,
    getCorrelationData,
    loadGlobalEvents
  };

})();